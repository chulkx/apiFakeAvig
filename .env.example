# URL of the parking-disponibility-service webhook endpoint
TARGET_URL=http://localhost:3000/webhook

# Base64-encoded 16-byte secret (must match AVIGILON_WEBHOOK_TOKEN on the real service)
# Generate one with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
AVIGILON_TOKEN=

# Port for this fake API
PORT=4000
